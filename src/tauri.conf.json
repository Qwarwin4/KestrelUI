{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KestrelUI",
  "identifier": "com.qwarwin.kestrelui",
  "version": "../package.json",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**/*",
          "$TEMP/**/*",
          "$APPDATA/**/*",
          "$LOCALDATA/**/*",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.png",
          "**/*.webp",
          "**/*.gif",
          "**/*.svg"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "build": {
    "beforeDevCommand": "npm run build:ui -- --serve",
    "beforeBuildCommand": "npm run build:ui -- --production",
    "devUrl": "http://localhost:3579",
    "frontendDist": "../dist",
    "features": []
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Qwarwin",
    "category": "Utility",
    "copyright": "Copyright © 2024 Seelen Corp., © 2026 KestrelUI contributors (AGPL-3.0)",
    "shortDescription": "KestrelUI",
    "longDescription": "KestrelUI Fully Customizable Desktop Environment for Windows",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/Qwarwin4/KestrelUI",
    "resources": {
      "static": "static"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "static/icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "static/icons/installer.ico",
        "uninstallerIcon": "static/icons/uninstaller.ico",
        "sidebarImage": "static/icons/banner.bmp",
        "template": "templates/installer.nsi",
        "installerHooks": "templates/installer-hooks.nsh",
        "installMode": "perMachine",
        "startMenuFolder": "Seelen",
        "displayLanguageSelector": true,
        "languages": [
          "arabic",
          "bulgarian",
          "dutch",
          "english",
          "french",
          "german",
          "italian",
          "japanese",
          "korean",
          "norwegian",
          "portuguese",
          "portuguesebr",
          "russian",
          "simpchinese",
          "spanish",
          "swedish",
          "tradchinese",
          "turkish",
          "ukrainian",
          "vietnamese"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          ".slu"
        ],
        "name": "kestrelui.file",
        "description": "KestrelUI File",
        "mimeType": "text/plain",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "kestrelui.uri"
        ]
      }
    }
  }
}
